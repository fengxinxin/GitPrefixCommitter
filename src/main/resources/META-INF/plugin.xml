<!--                          relative-to-action="com.iolo.gitprefix.ManualAction"/>-->
<!--        </action>-->
<!--    </actions>-->

    <actions>
        <action id="GitPrefix.Manual" class="com.iolo.gitprefix.actions.ManualGitPrefixAction"
                text="Generate and Review"
                description="Generate git command with predefined prefix"
                icon="com.iolo.gitprefix.MyIcons.GitPrefixCommitterManual">
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="first"/>
        </action>

        <action id="GitPrefix.Auto" class="com.iolo.gitprefix.actions.AutoGitPrefixAction"
                text="Generate and Run Instantly"
                description="Automation running git command predefined prefix"
                icon="com.iolo.gitprefix.MyIcons.GitPrefixCommitterAutomation">
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="after"
                          relative-to-action="GitPrefix.Manual"/>
        </action>
    </actions>
</idea-plugin>